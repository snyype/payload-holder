<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: paste this into the SignPath project (Artifact Configurations).
     The GitHub artifact "unsigned-windows" is a zip containing the two Windows binaries. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="payload_windows_amd64.exe" />
      <include path="payload_windows_arm64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
